# Copy this file to .env and fill it in. Every example reads it.
# Your Teak integration contact gives you sandbox keys.

# Public key (pk_...): used by the widget in the browser.
TEAK_PUBLIC_KEY=
# Secret key (sk_...): used only on your server, to get access tokens.
TEAK_SECRET_KEY=
# Your webhook subscription's secret, from the Teak Dashboard. Used by the webhooks example.
TEAK_WEBHOOK_SECRET=

# The Teak Partner API. Sandbox by default.
TEAK_API_BASE=https://api.sandbox.protecht.com/api/v2
