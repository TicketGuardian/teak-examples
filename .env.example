# Copy this file to .env and fill it in. Every example reads it.
# Your Teak integration contact gives you sandbox keys.

# Public key (pk_...): used by the widget in the browser, and with the secret key to get access tokens.
TEAK_PUBLIC_KEY=
# Secret key (sk_...): used only on your server, to get access tokens.
TEAK_SECRET_KEY=
# Your webhook subscription's secret, from the Teak Dashboard. Used by the webhooks example.
TEAK_WEBHOOK_SECRET=

# Server-to-server example only: whether your protection is optional or embedded. Your Teak
# integration contact tells you which.
TEAK_COVERAGE=optional

# The Teak Partner API. Sandbox by default.
TEAK_API_BASE=https://api.sandbox.helloteak.com/v1
